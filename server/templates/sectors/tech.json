{
  "id": "tech",
  "label": "Tech & Digital",
  "emoji": "💻",
  "description": "Développeur, agence web, startup, infographiste, community manager...",
  "histoire": "La matrice vivante du code",
  "keywords": ["développeur", "dev", "agence web", "startup", "infographiste", "community manager", "designer", "ux", "ui", "data", "ia", "intelligence artificielle", "cybersécurité", "cloud", "it", "informatique", "digital", "tech", "software", "seo", "marketing digital"],
  "palette": {
    "background": "#030712",
    "accent": "#06b6d4",
    "text": "#e2e8f0",
    "muted": "#475569",
    "border": "#06b6d433"
  },
  "layout": {
    "format": "minimal-dark",
    "width": 640,
    "height": 195,
    "photoPosition": "none",
    "logoSize": "small",
    "emphasis": "portfolio"
  },
  "effects": {
    "primary": "GLITCH SPAWN",
    "secondary": "QUANTUM PHASE",
    "accent": "REALITY GLITCH",
    "intensity": "medium",
    "locked": true
  },
  "sequence_narrative": {
    "acte1_boot": {
      "duree": 2000,
      "description": "Noir → bleu électrique → noir",
      "elements": {
        "nom": { "effets": ["GLITCH_SPAWN", "REALITY_GLITCH", "DIMENSION_SHIFT"], "action": "Glitch comme une réalité qui se charge" }
      }
    },
    "acte2_initialisation": {
      "duree": 3000,
      "elements": {
        "titre": { "effets": ["TYPEWRITER", "ENERGY_IONIZE"], "action": "S'écrit comme du code dans un terminal" },
        "competences": { "effets": ["DNA_BUILD", "PARTICLE_BUILD"], "action": "Les technologies s'assemblent comme un ADN" }
      }
    },
    "acte3_connexion": {
      "duree": 2500,
      "elements": {
        "portfolio": { "effets": ["NEON_GLOW", "ECHO_TRAIL"], "action": "Traînée lumineuse comme une connexion réseau" }
      }
    },
    "acte4_presence": {
      "duree": "infinite",
      "iteration": 7000,
      "elements": {
        "email": { "effets": ["WAVE_DISTORTION"], "action": "Onde de distorsion continue" }
      }
    }
  },
  "elements": [
    {
      "id": "nom",
      "type": "identite",
      "animation": { "effets": ["GLITCH_SPAWN", "REALITY_GLITCH", "DIMENSION_SHIFT"], "delai": 0, "duree": 3000, "iteration": 1 }
    },
    {
      "id": "titre",
      "type": "poste",
      "animation": { "effets": ["TYPEWRITER", "ENERGY_IONIZE"], "delai": 1, "duree": 2000, "iteration": 1 }
    },
    {
      "id": "competences",
      "type": "stack",
      "animation": { "effets": ["DNA_BUILD", "PARTICLE_BUILD"], "delai": 1.8, "duree": 2500, "iteration": 1 }
    },
    {
      "id": "portfolio",
      "type": "lien",
      "animation": { "effets": ["NEON_GLOW", "ECHO_TRAIL"], "delai": 2.5, "duree": 2000, "iteration": "infinite" }
    },
    {
      "id": "email",
      "type": "contact",
      "animation": { "effets": ["WAVE_DISTORTION"], "delai": 3.5, "duree": 1500, "iteration": "infinite" }
    }
  ],
  "fields": [
    { "key": "nom", "label": "Nom / Pseudo", "required": true, "type": "text" },
    { "key": "titre", "label": "Titre / Stack", "required": true, "type": "text" },
    { "key": "entreprise", "label": "Entreprise / Freelance", "required": false, "type": "text" },
    { "key": "email", "label": "Email", "required": true, "type": "email" },
    { "key": "portfolio", "label": "Portfolio / GitHub", "required": true, "type": "url" },
    { "key": "linkedin", "label": "LinkedIn", "required": false, "type": "url" },
    { "key": "site", "label": "Site Web", "required": false, "type": "url" },
    { "key": "competences", "label": "Compétences clés", "required": false, "type": "badge" }
  ],
  "tone": "Futuriste, précis, innovant",
  "cta": "Voir mon portfolio"
}
