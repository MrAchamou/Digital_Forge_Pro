        "nom": { "effets": ["TYPEWRITER", "TIME_ECHO"], "action": "S'écrit comme un acte notarié" }
      }
    },
    "acte2_legitimite": {
      "duree": 2500,
      "elements": {
        "cabinet": { "effets": ["CRYSTAL_GROW"], "action": "Se cristallise comme un sceau" },
        "ordre": { "effets": ["FADE_LAYERS"], "action": "Apparait en transparence comme un filigrane" }
      }
    },
    "acte3_professionnel": {
      "duree": "infinite",
      "iteration": 12000,
      "elements": {
        "email": { "effets": ["NEURAL_PULSE"], "action": "Pulse très discrètement" },
        "telephone": { "effets": ["TIME_ECHO"], "action": "Léger écho dans le temps" }
      }
    }
