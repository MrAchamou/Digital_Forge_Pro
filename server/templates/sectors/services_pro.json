    {
      "id": "cabinet",
      "type": "societe",
      "animation": { "effets": ["CRYSTAL_GROW"], "delai": 1.2, "duree": 2000, "iteration": 1 }
    },
    {
      "id": "ordre",
      "type": "legal",
      "animation": { "effets": ["FADE_LAYERS"], "delai": 2, "duree": 1500, "iteration": 1 }
    },
    {
      "id": "email",
      "type": "contact",
      "animation": { "effets": ["NEURAL_PULSE"], "delai": 2.8, "duree": 1500, "iteration": "infinite" }
