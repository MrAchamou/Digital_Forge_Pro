        "nom": { "effets": ["CRYSTAL_GROW"], "action": "Nom qui s'illumine comme une signature de prestige" },
        "titre": { "effets": ["DIMENSION_SHIFT"], "action": "Glisse depuis une autre dimension" }
      }
