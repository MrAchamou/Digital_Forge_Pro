<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; }

  /* === KEYFRAMES NARRATIFS — IMMOBILIER === */
  @keyframes sigHologram {
    0%,100% { opacity:1; transform:none; filter:none; }
    15%,45%,75% { opacity:0.6; transform:skewX(1.5deg); filter:hue-rotate(10deg); }
    30%,60% { opacity:0.8; transform:skewX(-1deg); }
  }
  @keyframes sigPrismSplit {
    0%,100% { filter:none; }
    50% { filter:hue-rotate(20deg) saturate(1.8) brightness(1.2); }
  }
  @keyframes sigCrystalGrow {
    0% { opacity:0; transform:scale(0.75) rotate(-2deg); filter:brightness(2); }
    70% { filter:brightness(1.1); }
    100% { opacity:1; transform:scale(1) rotate(0deg); filter:brightness(1); }
  }
  @keyframes sigDimensionShift {
    0% { opacity:0; transform:perspective(600px) rotateY(-25deg); }
    100% { opacity:1; transform:perspective(600px) rotateY(0deg); }
  }
  @keyframes sigEchoMultiple {
    0%,100% { text-shadow:none; }
    50% { text-shadow:5px 0 rgba(14,165,233,0.5),10px 0 rgba(14,165,233,0.25),15px 0 rgba(14,165,233,0.1); }
  }
  @keyframes sigFadeLayers {
    0% { opacity:0; }
    100% { opacity:1; }
  }
  @keyframes sigTypewriter {
    from { clip-path:inset(0 100% 0 0); }
    to { clip-path:inset(0 0% 0 0); }
  }
  @keyframes sigShimmer {
    0%,100% { box-shadow:0 0 8px rgba(14,165,233,0.3); }
    50% { box-shadow:0 0 20px rgba(14,165,233,0.7),0 0 40px rgba(14,165,233,0.3); }
  }

  /* === ELEMENTS NARRATIFS === */
  .sig-el-agence {
    opacity: 0;
    animation: sigCrystalGrow 1.2s ease-out 0s both, sigHologram 5s ease-in-out 2s infinite, sigPrismSplit 4s ease-in-out 1.5s infinite;
  }
  .sig-el-nom {
    opacity: 0;
    animation: sigCrystalGrow 1s ease-out 0.5s both;
  }
  .sig-el-titre {
    opacity: 0;
    animation: sigDimensionShift 0.8s ease-out 0.8s both;
  }
  .sig-el-zone {
    opacity: 0;
    animation: sigFadeLayers 0.8s ease-out 1.5s both;
  }
  .sig-el-telephone {
    opacity: 0;
    animation: sigCrystalGrow 0.6s ease-out 2s both, sigEchoMultiple 3s ease-in-out 2.8s infinite;
  }
  .sig-el-email {
    opacity: 0;
    animation: sigFadeLayers 0.8s ease-out 2.5s both;
  }
  .sig-el-site {
    opacity: 0;
    animation: sigTypewriter 1.5s steps(25,end) 3s both;
  }
  .sig-photo-wrap {
    animation: sigShimmer 3s ease-in-out infinite;
  }

  .sig-wrap {
    display: inline-flex;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 8px;
    width: {{layout.width}}px;
    min-height: {{layout.height}}px;
    overflow: hidden;
  }
  .sig-left {
    width: 200px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 16px;
    border-right: 1px solid var(--sig-border);
    gap: 12px;
  }
  .sig-photo-wrap {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--sig-accent);
  }
  .sig-photo-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .sig-photo-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--sig-accent);
    opacity: 0.2;
  }
  .sig-logo img { height: 32px; width: auto; }
  .sig-zone {
    font-size: 11px;
    color: var(--sig-muted);
    text-align: center;
    padding: 4px 10px;
    border: 1px solid var(--sig-border);
    border-radius: 20px;
  }
  .sig-right {
    flex: 1;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .sig-name { font-size: 20px; font-weight: 700; color: var(--sig-text); }
  .sig-titre {
    font-size: 12px;
    color: var(--sig-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 2px;
  }
  .sig-agence-txt { font-size: 13px; color: var(--sig-muted); margin-top: 4px; overflow: hidden; display: block; }
  .sig-divider {
    height: 1px;
    background: linear-gradient(to right, var(--sig-accent), transparent);
    margin: 12px 0;
  }
  .sig-contacts { display: flex; flex-direction: column; gap: 6px; }
  .sig-contact-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--sig-text);
    text-decoration: none;
  }
  .sig-contact-row:hover { color: var(--sig-accent); }
  .sig-contact-row.highlight { font-weight: 700; font-size: 15px; color: var(--sig-accent); }
  .sig-links { display: flex; gap: 12px; margin-top: 10px; flex-wrap: wrap; }
  .sig-link {
    font-size: 11px;
    color: var(--sig-accent);
    text-decoration: none;
    border: 1px solid var(--sig-accent);
    padding: 4px 10px;
    border-radius: 3px;
  }
  .sig-link:hover { background: var(--sig-accent); color: var(--sig-bg); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-left">
    {{#if data.photo_url}}
    <div class="sig-photo-wrap"><img src="{{data.photo_url}}" alt="{{data.nom}}"></div>
    {{else}}
    <div class="sig-photo-placeholder"></div>
    {{/if}}
    {{#if data.logo_url}}
    <div class="sig-logo"><img src="{{data.logo_url}}" alt="logo"></div>
    {{/if}}
    {{#if data.zone}}
    <div class="sig-zone sig-el-zone">📍 {{data.zone}}</div>
    {{/if}}
  </div>
  <div class="sig-right">
    <div>
      <div class="sig-name sig-el-nom">{{data.nom}}</div>
      <div class="sig-titre sig-el-titre">{{data.titre}}</div>
      {{#if data.agence}}<span class="sig-agence-txt sig-el-agence">{{data.agence}}</span>{{/if}}
    </div>
    <div class="sig-divider"></div>
    <div class="sig-contacts">
      {{#if data.telephone}}
      <a href="tel:{{data.telephone}}" class="sig-contact-row highlight sig-el-telephone">
        📞 {{data.telephone}}
      </a>
      {{/if}}
      {{#if data.email}}
      <a href="mailto:{{data.email}}" class="sig-contact-row sig-el-email">
        ✉ {{data.email}}
      </a>
      {{/if}}
    </div>
    <div class="sig-links">
      {{#if data.site}}<a href="{{data.site}}" class="sig-link sig-el-site">Annonces</a>{{/if}}
      {{#if data.linkedin}}<a href="{{data.linkedin}}" class="sig-link sig-el-site">LinkedIn</a>{{/if}}
    </div>
  </div>
</div>
</body>
</html>
