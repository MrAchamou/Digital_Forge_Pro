<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root { --sig-bg:{{palette.background}}; --sig-accent:{{palette.accent}}; --sig-text:{{palette.text}}; --sig-muted:{{palette.muted}}; --sig-border:{{palette.border}}; }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:transparent; font-family:'Segoe UI',Arial,sans-serif; }
  @keyframes sigLogoGlow { 0%,100% { box-shadow:0 0 0 2px var(--sig-accent),0 0 10px var(--sig-accent)50; } 50% { box-shadow:0 0 0 3px var(--sig-accent),0 0 24px var(--sig-accent)80,0 0 48px var(--sig-accent)35; } }
  @keyframes sigLogoIn { 0% { opacity:0; transform:translateX(-30px) scale(0.85); } 65% { transform:translateX(4px) scale(1.04); } 100% { opacity:1; transform:translateX(0) scale(1); } }
  @keyframes sigRed { 0%,100% { text-shadow:0 0 6px var(--sig-accent)80; } 50% { text-shadow:0 0 16px var(--sig-accent),0 0 32px var(--sig-accent)60,0 0 56px var(--sig-accent)30; } }
  @keyframes sigBarSlide { 0% { transform:scaleX(0); } 100% { transform:scaleX(1); } }
  @keyframes sigFade { 0% { opacity:0; } 100% { opacity:1; } }
  @keyframes sigSlideRight { 0% { opacity:0; transform:translateX(-14px); } 100% { opacity:1; transform:translateX(0); } }
  @keyframes sigRush { 0% { opacity:0; transform:translateX(-40px); } 60% { transform:translateX(4px); } 100% { opacity:1; transform:translateX(0); } }

  .sig-wrap { display:inline-flex; flex-direction:column; background:var(--sig-bg); border:1px solid var(--sig-border); border-radius:10px; width:{{layout.width}}px; overflow:hidden; }
  .sig-top-bar { height:3px; background:linear-gradient(90deg, transparent, var(--sig-accent), #f87171, var(--sig-accent), transparent); transform-origin:left; animation:sigBarSlide 0.6s ease-out both; }
  .sig-main { display:flex; align-items:stretch; padding:16px 18px; gap:16px; }
  .sig-logo-zone { flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:8px; }
  .sig-logo-frame { width:72px; height:72px; border-radius:8px; overflow:hidden; background:linear-gradient(135deg,var(--sig-accent)20,#78716c10); display:flex; align-items:center; justify-content:center; animation:sigLogoIn 0.7s cubic-bezier(0.25,1,0.5,1) 0s both,sigLogoGlow 2.5s ease-in-out 1.5s infinite; }
  .sig-logo-frame img { width:100%; height:100%; object-fit:contain; padding:6px; }
  .sig-logo-emoji { font-size:34px; line-height:1; }
  .sig-logo-dot { width:8px; height:8px; border-radius:50%; background:var(--sig-accent); animation:sigRed 1.8s ease-in-out 2s infinite; }
  .sig-vdivider { width:1px; background:linear-gradient(180deg,transparent,var(--sig-accent)60,transparent); flex-shrink:0; margin:4px 0; }
  .sig-info { flex:1; display:flex; flex-direction:column; gap:8px; min-width:0; }
  .sig-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
  .sig-header-left { display:flex; flex-direction:column; gap:2px; }
  .sig-name { font-size:18px; font-weight:800; color:var(--sig-text); line-height:1.1; opacity:0; animation:sigRush 0.7s ease-out 0.2s both; }
  .sig-titre { font-size:11px; font-weight:700; color:var(--sig-accent); text-transform:uppercase; letter-spacing:0.1em; opacity:0; animation:sigSlideRight 0.7s ease-out 0.45s both; }
  .sig-rating { display:flex; align-items:center; gap:4px; font-size:11px; color:var(--sig-muted); opacity:0; animation:sigFade 0.8s ease-out 1.1s both; white-space:nowrap; flex-shrink:0; }
  .sig-stars { color:#fbbf24; font-size:11px; }
  .sig-hdivider { height:1px; background:linear-gradient(90deg,var(--sig-accent)60,transparent); opacity:0; animation:sigFade 0.8s ease-out 0.7s both; }
  .sig-contacts { display:grid; grid-template-columns:1fr 1fr; gap:5px 14px; }
  .sig-contact-item { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--sig-text); text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:0; }
  .sig-contact-item.phone { font-size:14px; font-weight:800; color:var(--sig-accent); animation:sigRush 0.6s ease-out 0.8s both,sigRed 2s ease-in-out 2s infinite; }
  .sig-contact-item.email { animation:sigSlideRight 0.8s ease-out 1s both; }
  .sig-contact-item.site { animation:sigSlideRight 0.8s ease-out 1.1s both; }
  .sig-contact-item.zone { animation:sigFade 0.8s ease-out 1.3s both; }
  .sig-icon { width:14px; height:14px; flex-shrink:0; font-size:12px; display:inline-flex; align-items:center; justify-content:center; color:var(--sig-accent); }
  .sig-badges { display:flex; flex-wrap:wrap; gap:5px; margin-top:2px; }
  .sig-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:4px; font-size:10px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; opacity:0; }
  .sig-badge.filled { background:var(--sig-accent); color:var(--sig-bg); animation:sigFade 0.8s ease-out 1.5s both; }
  .sig-badge.outline { background:transparent; border:1px solid var(--sig-accent); color:var(--sig-accent); animation:sigFade 0.8s ease-out 1.7s both; }
  .sig-cta-bar { display:flex; align-items:center; justify-content:space-between; padding:9px 18px; background:linear-gradient(90deg,var(--sig-accent)20,transparent); border-top:1px solid var(--sig-accent)30; opacity:0; animation:sigFade 1s ease-out 1.8s both; }
  .sig-cta-text { font-size:11px; font-weight:700; color:var(--sig-accent); letter-spacing:0.04em; text-transform:uppercase; }
  .sig-cta-arrow { font-size:14px; color:var(--sig-accent); animation:sigRed 1.5s ease-in-out 3s infinite; }
  a { text-decoration:none; color:inherit; } a:hover { color:var(--sig-accent); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-top-bar"></div>
  <div class="sig-main">
    <div class="sig-logo-zone">
      <div class="sig-logo-frame">
        {{#if data.logo_url}}<img src="{{data.logo_url}}" alt="{{data.entreprise}}">
        {{else}}<span class="sig-logo-emoji">🚚</span>{{/if}}
      </div>
      <div class="sig-logo-dot"></div>
    </div>
    <div class="sig-vdivider"></div>
    <div class="sig-info">
      <div class="sig-header">
        <div class="sig-header-left">
          <span class="sig-name">{{data.nom}}</span>
          <span class="sig-titre">{{data.titre}}</span>
        </div>
        {{#if data.note}}<div class="sig-rating"><span class="sig-stars">★</span> {{data.note}}</div>{{/if}}
      </div>
      <div class="sig-hdivider"></div>
      <div class="sig-contacts">
        {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item phone"><span class="sig-icon">📞</span> {{data.telephone}}</a>{{/if}}
        {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item email"><span class="sig-icon">✉</span> {{data.email}}</a>{{/if}}
        {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item site" target="_blank"><span class="sig-icon">🌐</span> {{data.site}}</a>{{/if}}
        {{#if data.zone_couverture}}<div class="sig-contact-item zone"><span class="sig-icon">📍</span> {{data.zone_couverture}}</div>{{/if}}
      </div>
      <div class="sig-badges">
        {{#if data.disponibilite}}<span class="sig-badge filled">⚡ {{data.disponibilite}}</span>{{/if}}
        {{#if data.assurance}}<span class="sig-badge outline">✓ {{data.assurance}}</span>{{/if}}
      </div>
    </div>
  </div>
  <div class="sig-cta-bar">
    <span class="sig-cta-text">{{cta}}</span>
    <span class="sig-cta-arrow">→</span>
  </div>
</div>
</body>
</html>
