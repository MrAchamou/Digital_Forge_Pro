<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Arial Black', 'Segoe UI', Arial, sans-serif; }

  /* === KEYFRAMES NARRATIFS — TRANSPORT === */
  @keyframes sigTornadoIn {
    0% { transform:rotate(0deg) scale(0.3); opacity:0; }
    60% { transform:rotate(540deg) scale(1.1); }
    100% { transform:rotate(720deg) scale(1); opacity:1; }
  }
  @keyframes sigGyroSpin {
    0%,100% { transform:rotate3d(1,1,0,0deg); }
    50% { transform:rotate3d(1,1,0,20deg); }
  }
  @keyframes sigTypewriter {
    from { clip-path:inset(0 100% 0 0); }
    to { clip-path:inset(0 0% 0 0); }
  }
  @keyframes sigTornadoPull {
    0% { opacity:0; transform:scale(0.5) rotate(-360deg); filter:brightness(3); }
    70% { filter:brightness(1.3); }
    100% { opacity:1; transform:scale(1) rotate(0deg); filter:brightness(1); }
  }
  @keyframes sigElectricPulse {
    0%,100% { box-shadow:0 0 0 transparent; filter:brightness(1); }
    50% { box-shadow:0 0 12px var(--sig-accent),0 0 24px rgba(239,68,68,0.4); filter:brightness(1.2); }
  }
  @keyframes sigWaveSurf {
    0%,100% { transform:translateX(0); }
    50% { transform:translateX(4px); }
  }
  @keyframes sigParticleBuild {
    0% { opacity:0; transform:translateY(10px); letter-spacing:0.2em; }
    100% { opacity:1; transform:translateY(0); letter-spacing:normal; }
  }
  @keyframes sigNeonGlow {
    0%,100% { filter:brightness(1); box-shadow:0 0 0 transparent; }
    50% { filter:brightness(1.5); box-shadow:0 0 10px var(--sig-accent); }
  }
  @keyframes sigSpeedPulse {
    0%,100% { transform:translateX(0); box-shadow:-4px 0 0 var(--sig-accent); }
    50% { transform:translateX(3px); box-shadow:-8px 0 0 var(--sig-accent),-16px 0 0 rgba(239,68,68,0.3); }
  }

  /* === ELEMENTS NARRATIFS === */
  .sig-el-logo {
    animation: sigTornadoIn 1.2s cubic-bezier(0.34,1.56,0.64,1) 0s both, sigGyroSpin 4s ease-in-out 2s infinite;
  }
  .sig-el-nom {
    opacity: 0;
    overflow: hidden;
    animation: sigTypewriter 1.2s steps(25,end) 0.5s both;
  }
  .sig-el-titre {
    opacity: 0;
    animation: sigParticleBuild 0.8s ease-out 0.8s both;
  }
  .sig-el-zone {
    opacity: 0;
    animation: sigParticleBuild 0.8s ease-out 1.2s both, sigWaveSurf 3s ease-in-out 2.5s infinite;
  }
  .sig-el-telephone {
    opacity: 0;
    animation: sigTornadoPull 1s ease-out 2s both, sigElectricPulse 2s ease-in-out 3.5s infinite, sigSpeedPulse 1.5s ease-in-out 3s infinite;
  }
  .sig-el-vehicule {
    opacity: 0;
    animation: sigParticleBuild 1s ease-out 2.5s both;
  }
  .sig-el-disponibilite {
    opacity: 0;
    animation: sigParticleBuild 0.8s ease-out 3s both, sigNeonGlow 2s ease-in-out 4s infinite;
  }

  .sig-wrap {
    display: inline-block;
    background: var(--sig-bg);
    width: {{layout.width}}px;
    overflow: hidden;
    border-radius: 4px;
    position: relative;
    border-top: 3px solid var(--sig-accent);
  }
  .sig-body {
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sig-logo-block {
    flex-shrink: 0;
    text-align: center;
  }
  .sig-logo-block img { height: 44px; width: auto; }
  .sig-logo-emoji { font-size: 36px; display: inline-block; }
  .sig-main { flex: 1; }
  .sig-name {
    font-size: 19px;
    font-weight: 900;
    color: var(--sig-text);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
  }
  .sig-titre { font-size: 12px; color: var(--sig-muted); margin-top: 2px; }
  .sig-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
  .sig-badge {
    font-size: 10px;
    padding: 2px 8px;
    background: var(--sig-accent);
    color: var(--sig-bg);
    font-weight: 700;
    border-radius: 2px;
    text-transform: uppercase;
  }
  .sig-badge.dark {
    background: transparent;
    border: 1px solid var(--sig-muted);
    color: var(--sig-muted);
  }
  .sig-cta-col {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .sig-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--sig-accent);
    color: #fff;
    text-decoration: none;
    padding: 10px 18px;
    font-size: 16px;
    font-weight: 900;
    border-radius: 3px;
    white-space: nowrap;
  }
  .sig-contact-small {
    font-size: 11px;
    color: var(--sig-muted);
    text-decoration: none;
  }
  .sig-contact-small:hover { color: var(--sig-accent); }
  .sig-bottom {
    padding: 8px 20px;
    border-top: 1px solid var(--sig-border);
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .sig-info {
    font-size: 11px;
    color: var(--sig-muted);
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }
  .sig-info:hover { color: var(--sig-accent); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-body">
    <div class="sig-logo-block sig-el-logo">
      {{#if data.logo_url}}
      <img src="{{data.logo_url}}" alt="{{data.nom}}">
      {{else}}
      <span class="sig-logo-emoji">🚚</span>
      {{/if}}
    </div>
    <div class="sig-main">
      <span class="sig-name sig-el-nom">{{data.nom}}</span>
      <div class="sig-titre sig-el-titre">{{data.titre}}</div>
      <div class="sig-badges">
        {{#if data.zone}}<span class="sig-badge sig-el-zone">{{data.zone}}</span>{{/if}}
        {{#if data.disponibilite}}<span class="sig-badge sig-el-disponibilite">{{data.disponibilite}}</span>{{/if}}
        {{#if data.vehicule}}<span class="sig-badge dark sig-el-vehicule">{{data.vehicule}}</span>{{/if}}
      </div>
    </div>
    {{#if data.telephone}}
    <div class="sig-cta-col">
      <a href="tel:{{data.telephone}}" class="sig-cta sig-el-telephone">
        📞 {{data.telephone}}
      </a>
      {{#if data.email}}
      <a href="mailto:{{data.email}}" class="sig-contact-small sig-el-titre">{{data.email}}</a>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{#if data.site}}
  <div class="sig-bottom">
    <a href="{{data.site}}" class="sig-info sig-el-vehicule">🌐 {{data.site}}</a>
  </div>
  {{/if}}
</div>
</body>
</html>
