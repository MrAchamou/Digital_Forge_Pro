<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }

  /* === KEYFRAMES NARRATIFS — COMMERCE === */
  @keyframes sigStarDustRainbow {
    0% { opacity:0; transform:scale(0.5); filter:brightness(4) hue-rotate(0deg); }
    50% { filter:brightness(2) hue-rotate(120deg); }
    100% { opacity:1; transform:scale(1); filter:brightness(1) hue-rotate(0deg); }
  }
  @keyframes sigNeonPulse {
    0%,100% { text-shadow:0 0 8px var(--sig-accent),0 0 16px var(--sig-accent); letter-spacing:0.02em; }
    50% { text-shadow:0 0 20px var(--sig-accent),0 0 40px var(--sig-accent),0 0 60px var(--sig-accent); letter-spacing:0.05em; }
  }
  @keyframes sigCrystalSparkle {
    0% { opacity:0; transform:scale(0.7) rotate(-3deg); filter:brightness(2.5); }
    70% { filter:brightness(1.3); }
    100% { opacity:1; transform:scale(1) rotate(0deg); filter:brightness(1); }
  }
  @keyframes sigLiquidMorph {
    0%,100% { transform:translateX(0) scaleX(1); }
    50% { transform:translateX(2px) scaleX(1.01); }
  }
  @keyframes sigFloatEnergy {
    0%,100% { transform:translateY(0); filter:brightness(1); }
    50% { transform:translateY(-4px); filter:brightness(1.3) drop-shadow(0 0 6px var(--sig-accent)); }
  }
  @keyframes sigGradientShift {
    0% { background-position:0% 50%; }
    100% { background-position:200% 50%; }
  }
  @keyframes sigFadeUp {
    0% { opacity:0; transform:translateY(10px); }
    100% { opacity:1; transform:translateY(0); }
  }

  /* === ELEMENTS NARRATIFS === */
  .sig-el-nom {
    opacity: 0;
    animation: sigStarDustRainbow 1.2s ease-out 0s both, sigNeonPulse 2.5s ease-in-out 1.5s infinite;
  }
  .sig-el-titre {
    opacity: 0;
    animation: sigCrystalSparkle 1s ease-out 0.5s both;
  }
  .sig-el-horaires {
    opacity: 0;
    animation: sigFadeUp 0.8s ease-out 1.5s both, sigLiquidMorph 3s ease-in-out 2.5s infinite;
  }
  .sig-el-adresse {
    opacity: 0;
    animation: sigFadeUp 0.8s ease-out 2s both;
  }
  .sig-el-telephone {
    opacity: 0;
    animation: sigFadeUp 0.6s ease-out 2.5s both;
  }
  .sig-el-instagram {
    opacity: 0;
    animation: sigFadeUp 0.6s ease-out 2.5s both, sigFloatEnergy 2s ease-in-out 3.5s infinite;
  }

  .sig-wrap {
    display: inline-block;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 10px;
    width: {{layout.width}}px;
    overflow: hidden;
    position: relative;
  }
  .sig-top-bar {
    height: 4px;
    background: linear-gradient(to right, var(--sig-accent), var(--sig-muted), var(--sig-accent));
    background-size: 200% 100%;
    animation: sigGradientShift 3s linear infinite;
  }
  .sig-body {
    padding: 18px 24px 20px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .sig-logo-block {
    flex-shrink: 0;
    width: 70px;
    height: 70px;
    border-radius: 12px;
    border: 2px solid var(--sig-accent);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(162,28,175,0.13), rgba(236,72,153,0.07));
  }
  .sig-logo-block img { width: 100%; height: 100%; object-fit: contain; }
  .sig-logo-emoji { font-size: 32px; }
  .sig-content { flex: 1; }
  .sig-name {
    font-size: 20px;
    font-weight: 800;
    color: var(--sig-text);
    display: block;
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-style: italic;
    margin-top: 2px;
    display: block;
  }
  .sig-info-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 10px;
  }
  .sig-info {
    font-size: 12px;
    color: var(--sig-text);
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sig-info a { color: inherit; text-decoration: none; }
  .sig-info a:hover { color: var(--sig-accent); }
  .sig-bottom {
    padding: 10px 24px 14px;
    border-top: 1px solid var(--sig-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sig-horaires { font-size: 11px; color: var(--sig-muted); }
  .sig-social { display: flex; gap: 8px; }
  .sig-social a {
    font-size: 11px;
    color: var(--sig-accent);
    text-decoration: none;
    padding: 3px 8px;
    border: 1px solid var(--sig-accent);
    border-radius: 20px;
  }
  .sig-social a:hover { background: var(--sig-accent); color: var(--sig-bg); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-top-bar"></div>
  <div class="sig-body">
    <div class="sig-logo-block">
      {{#if data.logo_url}}
      <img src="{{data.logo_url}}" alt="{{data.nom}}">
      {{else}}
      <span class="sig-logo-emoji">🛍️</span>
      {{/if}}
    </div>
    <div class="sig-content">
      <span class="sig-name sig-el-nom">{{data.nom}}</span>
      <span class="sig-titre sig-el-titre">{{data.titre}}</span>
      <div class="sig-info-row">
        {{#if data.adresse}}<span class="sig-info sig-el-adresse">📍 {{data.adresse}}</span>{{/if}}
        {{#if data.telephone}}<span class="sig-info sig-el-telephone">📞 <a href="tel:{{data.telephone}}">{{data.telephone}}</a></span>{{/if}}
        {{#if data.site}}<span class="sig-info sig-el-adresse">🛒 <a href="{{data.site}}">Boutique en ligne</a></span>{{/if}}
      </div>
    </div>
  </div>
  <div class="sig-bottom">
    {{#if data.horaires}}
    <span class="sig-horaires sig-el-horaires">🕐 {{data.horaires}}</span>
    {{/if}}
    <div class="sig-social">
      {{#if data.instagram}}<a href="{{data.instagram}}" class="sig-el-instagram">📸 Instagram</a>{{/if}}
      {{#if data.site}}<a href="{{data.site}}" class="sig-el-instagram">🛒 Shop</a>{{/if}}
    </div>
  </div>
</div>
</body>
</html>
