<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  {{{animation.keyframes}}}
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }
  .sig-wrap {
    display: inline-flex;
    align-items: stretch;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 6px;
    width: {{layout.width}}px;
    min-height: {{layout.height}}px;
    overflow: hidden;
    position: relative;
  }
  .sig-accent-bar {
    width: 4px;
    background: var(--sig-accent);
    flex-shrink: 0;
  }
  {{#if data.photo_url}}
  .sig-photo {
    width: 90px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .sig-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  {{/if}}
  .sig-body {
    flex: 1;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }
  .sig-header { display: flex; flex-direction: column; gap: 2px; }
  .sig-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--sig-text);
    animation: {{animation.cssAnimation}};
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .sig-divider {
    height: 1px;
    background: var(--sig-border);
  }
  .sig-contacts { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .sig-contact-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--sig-text);
    text-decoration: none;
  }
  .sig-contact-item .icon {
    color: var(--sig-accent);
    font-size: 14px;
    width: 16px;
    text-align: center;
  }
  .sig-contact-item.phone {
    font-size: 15px;
    font-weight: 700;
    color: var(--sig-accent);
  }
  .sig-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .sig-badge {
    display: inline-block;
    padding: 3px 10px;
    background: var(--sig-accent);
    color: var(--sig-bg);
    font-size: 11px;
    font-weight: 700;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sig-badge.outline {
    background: transparent;
    border: 1px solid var(--sig-accent);
    color: var(--sig-accent);
  }
  .sig-logo {
    position: absolute;
    top: 12px;
    right: 16px;
  }
  .sig-logo img { height: 36px; width: auto; object-fit: contain; }
  a.sig-contact-item { text-decoration: none; }
  a.sig-contact-item:hover { color: var(--sig-accent); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-accent-bar"></div>
  {{#if data.photo_url}}
  <div class="sig-photo">
    <img src="{{data.photo_url}}" alt="{{data.nom}}">
  </div>
  {{/if}}
  <div class="sig-body">
    <div class="sig-header">
      <span class="sig-name">{{data.nom}}</span>
      <span class="sig-titre">{{data.titre}}</span>
    </div>
    <div class="sig-divider"></div>
    <div class="sig-contacts">
      {{#if data.telephone}}
      <a href="tel:{{data.telephone}}" class="sig-contact-item phone">
        <span class="icon">📞</span> {{data.telephone}}
      </a>
      {{/if}}
      {{#if data.email}}
      <a href="mailto:{{data.email}}" class="sig-contact-item">
        <span class="icon">✉</span> {{data.email}}
      </a>
      {{/if}}
      {{#if data.site}}
      <a href="{{data.site}}" class="sig-contact-item">
        <span class="icon">🌐</span> {{data.site}}
      </a>
      {{/if}}
    </div>
    <div class="sig-badges">
      {{#if data.zone}}
      <span class="sig-badge">📍 {{data.zone}}</span>
      {{/if}}
      {{#if data.urgence}}
      <span class="sig-badge outline">⚡ {{data.urgence}}</span>
      {{/if}}
      {{#if data.siret}}
      <span class="sig-badge outline">✓ {{data.siret}}</span>
      {{/if}}
    </div>
  </div>
  {{#if data.logo_url}}
  <div class="sig-logo">
    <img src="{{data.logo_url}}" alt="logo">
  </div>
  {{/if}}
</div>
</body>
</html>
