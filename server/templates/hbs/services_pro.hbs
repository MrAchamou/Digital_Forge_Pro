<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Times New Roman', Georgia, serif; }

  /* === KEYFRAMES NARRATIFS — SERVICES PRO === */
  @keyframes sigTypewriter {
    from { clip-path:inset(0 100% 0 0); }
    to { clip-path:inset(0 0% 0 0); }
  }
  @keyframes sigTimeEcho {
    0% { opacity:0; transform:scale(1.08); }
    100% { opacity:1; transform:scale(1); }
  }
  @keyframes sigCrystalGrow {
    0% { opacity:0; transform:scale(0.85) rotate(-1deg); filter:brightness(1.8); }
    100% { opacity:1; transform:scale(1) rotate(0deg); filter:brightness(1); }
  }
  @keyframes sigFadeLayers {
    0% { opacity:0; }
    100% { opacity:1; }
  }
  @keyframes sigNeuralPulse {
    0%,100% { opacity:1; }
    50% { opacity:0.5; }
  }
  @keyframes sigSubtleFade {
    0%,100% { opacity:0.7; }
    50% { opacity:1; }
  }

  /* === ELEMENTS NARRATIFS === */
  .sig-el-nom {
    opacity: 0;
    overflow: hidden;
    animation: sigTypewriter 2s steps(30,end) 0s both;
  }
  .sig-el-titre {
    opacity: 0;
    animation: sigFadeLayers 1s ease-out 0.8s both;
  }
  .sig-el-cabinet {
    opacity: 0;
    animation: sigCrystalGrow 1s ease-out 1.2s both;
  }
  .sig-el-ordre {
    opacity: 0;
    animation: sigFadeLayers 1.2s ease-out 2s both;
  }
  .sig-el-email {
    opacity: 0;
    animation: sigFadeLayers 0.8s ease-out 2.8s both, sigNeuralPulse 4s ease-in-out 4s infinite;
  }
  .sig-el-telephone {
    opacity: 0;
    animation: sigTimeEcho 1s ease-out 3.2s both;
  }
  .sig-accent-line {
    animation: sigSubtleFade 5s ease-in-out infinite;
  }

  .sig-wrap {
    display: inline-flex;
    background: var(--sig-bg);
    border-left: 3px solid var(--sig-accent);
    width: {{layout.width}}px;
    min-height: {{layout.height}}px;
    overflow: hidden;
  }
  .sig-photo-col {
    width: 80px;
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 20px;
  }
  .sig-photo-wrap {
    width: 60px;
    height: 60px;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--sig-border);
  }
  .sig-photo-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .sig-photo-placeholder {
    width: 60px;
    height: 60px;
    border-radius: 3px;
    background: var(--sig-accent);
    opacity: 0.15;
  }
  .sig-body {
    flex: 1;
    padding: 20px 22px 20px 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sig-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--sig-text);
    letter-spacing: 0.02em;
    display: block;
  }
  .sig-titre {
    font-size: 12px;
    color: var(--sig-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: 600;
  }
  .sig-cabinet {
    font-size: 13px;
    color: var(--sig-muted);
    font-style: italic;
  }
  .sig-accent-line {
    height: 1px;
    background: var(--sig-accent);
    opacity: 0.4;
  }
  .sig-contacts { display: flex; flex-direction: column; gap: 5px; }
  .sig-contact-item {
    font-size: 12px;
    color: var(--sig-text);
    font-family: 'Segoe UI', Arial, sans-serif;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sig-contact-item:hover { color: var(--sig-accent); }
  .sig-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .sig-badge {
    font-size: 10px;
    padding: 2px 8px;
    border: 1px solid var(--sig-border);
    color: var(--sig-muted);
    font-family: 'Segoe UI', Arial, sans-serif;
    letter-spacing: 0.04em;
  }
  .sig-logo-col {
    width: 70px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 20px 16px 0 0;
  }
  .sig-logo-col img { width: 50px; height: auto; }
  .sig-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
  .sig-link {
    font-size: 11px;
    color: var(--sig-accent);
    text-decoration: none;
    font-family: 'Segoe UI', Arial, sans-serif;
  }
  .sig-link:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-photo-col">
    {{#if data.photo_url}}
    <div class="sig-photo-wrap"><img src="{{data.photo_url}}" alt="{{data.nom}}"></div>
    {{else}}
    <div class="sig-photo-placeholder"></div>
    {{/if}}
  </div>
  <div class="sig-body">
    <div>
      <span class="sig-name sig-el-nom">{{data.nom}}</span>
      <div class="sig-titre sig-el-titre">{{data.titre}}</div>
      {{#if data.cabinet}}<div class="sig-cabinet sig-el-cabinet">{{data.cabinet}}</div>{{/if}}
    </div>
    <div class="sig-accent-line"></div>
    <div class="sig-contacts">
      {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item sig-el-email">✉ {{data.email}}</a>{{/if}}
      {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item sig-el-telephone">☎ {{data.telephone}}</a>{{/if}}
    </div>
    <div class="sig-badges">
      {{#if data.ordre}}<span class="sig-badge sig-el-ordre">N° {{data.ordre}}</span>{{/if}}
    </div>
    <div class="sig-links">
      {{#if data.site}}<a href="{{data.site}}" class="sig-link sig-el-telephone">Site web</a>{{/if}}
      {{#if data.linkedin}}<a href="{{data.linkedin}}" class="sig-link sig-el-telephone">LinkedIn</a>{{/if}}
    </div>
  </div>
  {{#if data.logo_url}}
  <div class="sig-logo-col"><img src="{{data.logo_url}}" alt="logo"></div>
  {{/if}}
</div>
</body>
</html>
