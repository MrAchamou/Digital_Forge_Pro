<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root { --sig-bg:{{palette.background}}; --sig-accent:{{palette.accent}}; --sig-text:{{palette.text}}; --sig-muted:{{palette.muted}}; --sig-border:{{palette.border}}; }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:transparent; font-family:'Segoe UI',Arial,sans-serif; }
  @keyframes sigLogoGlow { 0%,100% { box-shadow:0 0 0 2px var(--sig-accent),0 0 10px var(--sig-accent)40; } 50% { box-shadow:0 0 0 3px var(--sig-accent),0 0 22px var(--sig-accent)60,0 0 44px var(--sig-accent)25; } }
  @keyframes sigLogoIn { 0% { opacity:0; transform:scale(0.85) translateX(-10px); } 70% { transform:scale(1.04) translateX(2px); } 100% { opacity:1; transform:scale(1) translateX(0); } }
  @keyframes sigAuthority { 0%,100% { text-shadow:0 0 6px var(--sig-accent)60; } 50% { text-shadow:0 0 14px var(--sig-accent),0 0 28px var(--sig-accent)50; } }
  @keyframes sigBarSlide { 0% { transform:scaleX(0); } 100% { transform:scaleX(1); } }
  @keyframes sigFade { 0% { opacity:0; } 100% { opacity:1; } }
  @keyframes sigSlideUp { 0% { opacity:0; transform:translateY(10px); } 100% { opacity:1; transform:translateY(0); } }
  @keyframes sigPrestige { 0% { opacity:0; transform:translateX(16px); } 100% { opacity:1; transform:translateX(0); } }

  .sig-wrap { display:inline-flex; flex-direction:column; background:var(--sig-bg); border:1px solid var(--sig-border); border-radius:10px; width:{{layout.width}}px; overflow:hidden; }
  .sig-top-bar { height:4px; background:linear-gradient(90deg, transparent, var(--sig-accent), #818cf8, var(--sig-accent), transparent); transform-origin:left; animation:sigBarSlide 0.8s ease-out both; }
  .sig-main { display:flex; align-items:stretch; padding:16px 18px; gap:16px; }

  .sig-logo-zone { flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:8px; }
  .sig-logo-frame { width:88px; height:88px; border-radius:10px; overflow:hidden; background:linear-gradient(135deg,var(--sig-accent)15,#312e8115); display:flex; align-items:center; justify-content:center; animation:sigLogoIn 0.9s ease-out 0s both, sigLogoGlow 3.5s ease-in-out 1.5s infinite; }
  .sig-logo-frame img { width:100%; height:100%; object-fit:contain; padding:8px; }
  .sig-logo-emoji { font-size:40px; line-height:1; }
  .sig-logo-dot { width:8px; height:8px; border-radius:50%; background:var(--sig-accent); animation:sigAuthority 2.5s ease-in-out 2s infinite; }

  .sig-vdivider { width:1px; background:linear-gradient(180deg,transparent,var(--sig-accent)60,transparent); flex-shrink:0; margin:4px 0; }

  .sig-info { flex:1; display:flex; flex-direction:column; gap:7px; min-width:0; }

  .sig-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
  .sig-header-left { display:flex; flex-direction:column; gap:2px; }
  .sig-name { font-size:18px; font-weight:800; color:var(--sig-text); line-height:1.15; opacity:0; animation:sigPrestige 0.9s ease-out 0.3s both; }
  .sig-titre { font-size:11px; font-weight:700; color:var(--sig-accent); text-transform:uppercase; letter-spacing:0.12em; opacity:0; animation:sigPrestige 0.8s ease-out 0.55s both; }
  .sig-entreprise { font-size:11px; color:var(--sig-muted); opacity:0; animation:sigFade 0.8s ease-out 0.7s both; }
  .sig-rating { display:flex; align-items:center; gap:4px; font-size:11px; color:var(--sig-muted); opacity:0; animation:sigFade 0.8s ease-out 1.2s both; white-space:nowrap; flex-shrink:0; }
  .sig-stars { color:#fbbf24; letter-spacing:1px; }

  .sig-hdivider { height:1px; background:linear-gradient(90deg,var(--sig-accent)60,transparent); opacity:0; animation:sigFade 0.8s ease-out 0.8s both; }

  .sig-contacts { display:flex; flex-direction:column; gap:5px; }
  .sig-contact-item { display:flex; align-items:center; gap:7px; font-size:12px; color:var(--sig-text); text-decoration:none; overflow:hidden; opacity:0; }
  .sig-contact-item.phone { font-size:15px; font-weight:800; color:var(--sig-accent); animation:sigSlideUp 0.7s ease-out 0.9s both, sigAuthority 2.5s ease-in-out 2s infinite; }
  .sig-contact-item.email { animation:sigSlideUp 0.8s ease-out 1.05s both; }
  .sig-contact-item.site { animation:sigSlideUp 0.8s ease-out 1.15s both; }
  .sig-contact-item.addr { animation:sigFade 0.8s ease-out 1.25s both; }
  .sig-icon { width:15px; flex-shrink:0; font-size:12px; display:inline-flex; align-items:center; justify-content:center; color:var(--sig-accent); }

  .sig-addr-block { display:flex; align-items:center; gap:7px; padding:5px 8px; background:var(--sig-accent)10; border-left:2px solid var(--sig-accent)60; border-radius:0 4px 4px 0; font-size:11px; color:var(--sig-muted); opacity:0; animation:sigFade 0.8s ease-out 1.35s both; }

  .sig-footer { display:flex; align-items:center; justify-content:space-between; padding:8px 18px; background:linear-gradient(90deg,var(--sig-accent)12,transparent); border-top:1px solid var(--sig-accent)30; opacity:0; animation:sigFade 1s ease-out 1.6s both; gap:10px; }
  .sig-badges { display:flex; flex-wrap:wrap; gap:5px; }
  .sig-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:4px; font-size:10px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; }
  .sig-badge.filled { background:var(--sig-accent); color:var(--sig-bg); }
  .sig-badge.outline { background:transparent; border:1px solid var(--sig-accent); color:var(--sig-accent); }
  .sig-cta { display:flex; align-items:center; gap:5px; white-space:nowrap; }
  .sig-cta-text { font-size:11px; font-weight:600; color:var(--sig-accent); letter-spacing:0.04em; }
  .sig-cta-arrow { font-size:14px; color:var(--sig-accent); animation:sigAuthority 2s ease-in-out 3s infinite; }
  a { text-decoration:none; color:inherit; } a:hover { color:var(--sig-accent); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-top-bar"></div>
  <div class="sig-main">
    <div class="sig-logo-zone">
      <div class="sig-logo-frame">
        {{#if data.logo_url}}<img src="{{data.logo_url}}" alt="{{data.entreprise}}">
        {{else}}<span class="sig-logo-emoji">⚖️</span>{{/if}}
      </div>
      <div class="sig-logo-dot"></div>
    </div>
    <div class="sig-vdivider"></div>
    <div class="sig-info">
      <div class="sig-header">
        <div class="sig-header-left">
          <span class="sig-name">{{data.nom}}</span>
          <span class="sig-titre">{{data.titre}}</span>
          {{#if data.entreprise}}<span class="sig-entreprise">{{data.entreprise}}</span>{{/if}}
        </div>
        {{#if data.note}}<div class="sig-rating"><span class="sig-stars">★</span> {{data.note}}</div>{{/if}}
      </div>
      <div class="sig-hdivider"></div>
      <div class="sig-contacts">
        {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item phone"><span class="sig-icon">📞</span>{{data.telephone}}</a>{{/if}}
        {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item email"><span class="sig-icon">✉</span>{{data.email}}</a>{{/if}}
        {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item site" target="_blank"><span class="sig-icon">🌐</span>{{data.site}}</a>{{/if}}
      </div>
      {{#if data.adresse}}<div class="sig-addr-block"><span class="sig-icon">📍</span>{{data.adresse}}</div>{{/if}}
    </div>
  </div>
  <div class="sig-footer">
    <div class="sig-badges">
      {{#if data.domaine}}<span class="sig-badge filled">⚖ {{data.domaine}}</span>{{/if}}
      {{#if data.barreau}}<span class="sig-badge outline">✓ {{data.barreau}}</span>{{/if}}
    </div>
    <div class="sig-cta">
      <span class="sig-cta-text">{{cta}}</span>
      <span class="sig-cta-arrow">→</span>
    </div>
  </div>
</div>
</body>
</html>
