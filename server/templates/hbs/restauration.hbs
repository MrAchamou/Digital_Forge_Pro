<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  {{{animation.keyframes}}}
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Georgia', 'Times New Roman', serif; }
  .sig-wrap {
    display: inline-block;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 8px;
    width: {{layout.width}}px;
    overflow: hidden;
    text-align: center;
  }
  .sig-photo-banner {
    width: 100%;
    height: 80px;
    overflow: hidden;
    position: relative;
  }
  .sig-photo-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
  }
  .sig-photo-banner .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--sig-bg));
  }
  .sig-logo-center {
    margin: -28px auto 8px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--sig-accent);
    background: var(--sig-bg);
    position: relative;
    z-index: 1;
  }
  .sig-logo-center img { width: 100%; height: 100%; object-fit: cover; }
  .sig-logo-placeholder {
    margin: 16px auto 8px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--sig-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }
  .sig-body { padding: 0 24px 16px; }
  .sig-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--sig-text);
    animation: {{animation.cssAnimation}};
    display: block;
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-style: italic;
    margin-top: 2px;
    display: block;
  }
  .sig-divider {
    margin: 10px auto;
    width: 60px;
    height: 2px;
    background: var(--sig-accent);
    border-radius: 1px;
  }
  .sig-contacts {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-bottom: 8px;
  }
  .sig-contact-item {
    font-size: 12px;
    color: var(--sig-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sig-contact-item:hover { color: var(--sig-accent); }
  .sig-horaires {
    font-size: 11px;
    color: var(--sig-muted);
    margin-bottom: 8px;
  }
  .sig-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--sig-border);
    flex-wrap: wrap;
  }
  .sig-rating {
    color: var(--sig-accent);
    font-size: 14px;
    font-weight: 700;
  }
  .sig-link {
    font-size: 11px;
    color: var(--sig-accent);
    text-decoration: none;
  }
  .sig-link:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="sig-wrap">
  {{#if data.photo_url}}
  <div class="sig-photo-banner">
    <img src="{{data.photo_url}}" alt="{{data.nom}}">
    <div class="overlay"></div>
  </div>
  {{/if}}
  {{#if data.logo_url}}
  <div class="sig-logo-center"><img src="{{data.logo_url}}" alt="logo"></div>
  {{else}}
  <div class="sig-logo-placeholder">🍽️</div>
  {{/if}}
  <div class="sig-body">
    <span class="sig-name">{{data.nom}}</span>
    <span class="sig-titre">{{data.titre}}</span>
    <div class="sig-divider"></div>
    <div class="sig-contacts">
      {{#if data.adresse}}
      <span class="sig-contact-item">📍 {{data.adresse}}</span>
      {{/if}}
      {{#if data.telephone}}
      <a href="tel:{{data.telephone}}" class="sig-contact-item">📞 {{data.telephone}}</a>
      {{/if}}
      {{#if data.site}}
      <a href="{{data.site}}" class="sig-contact-item">🌐 Menu & réservation</a>
      {{/if}}
    </div>
    {{#if data.horaires}}
    <div class="sig-horaires">🕐 {{data.horaires}}</div>
    {{/if}}
    <div class="sig-footer">
      {{#if data.note}}
      <span class="sig-rating">★ {{data.note}}</span>
      {{/if}}
      {{#if data.instagram}}
      <a href="{{data.instagram}}" class="sig-link">📸 Instagram</a>
      {{/if}}
      {{#if data.site}}
      <a href="{{data.site}}" class="sig-link">Voir le menu →</a>
      {{/if}}
    </div>
  </div>
</div>
</body>
</html>
