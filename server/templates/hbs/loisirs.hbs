<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  {{{animation.keyframes}}}
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }
  .sig-wrap {
    display: inline-block;
    background: var(--sig-bg);
    border-radius: 10px;
    width: {{layout.width}}px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--sig-border);
  }
  .sig-banner {
    height: 90px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--sig-muted), var(--sig-accent));
  }
  .sig-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  .sig-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, var(--sig-bg));
  }
  .sig-logo-abs {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 20px;
  }
  .sig-logo-abs img {
    height: 50px;
    width: auto;
    filter: drop-shadow(0 0 10px var(--sig-accent));
  }
  .sig-body {
    padding: 8px 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sig-name {
    font-size: 22px;
    font-weight: 800;
    color: var(--sig-text);
    animation: {{animation.cssAnimation}};
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-weight: 600;
    margin-top: 2px;
  }
  .sig-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .sig-contact-item {
    font-size: 12px;
    color: var(--sig-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sig-contact-item:hover { color: var(--sig-accent); }
  .sig-rating {
    font-size: 16px;
    font-weight: 800;
    color: var(--sig-accent);
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .sig-cta {
    display: inline-block;
    background: linear-gradient(to right, var(--sig-accent), var(--sig-muted));
    color: #fff;
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    align-self: flex-start;
  }
  .sig-cta:hover { opacity: 0.9; }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-banner">
    {{#if data.photo_url}}
    <img src="{{data.photo_url}}" alt="{{data.nom}}">
    {{/if}}
    <div class="sig-banner-overlay"></div>
    {{#if data.logo_url}}
    <div class="sig-logo-abs"><img src="{{data.logo_url}}" alt="logo"></div>
    {{/if}}
  </div>
  <div class="sig-body">
    <div>
      <div class="sig-name">{{data.nom}}</div>
      <div class="sig-titre">{{data.titre}}</div>
    </div>
    <div class="sig-row">
      {{#if data.adresse}}<span class="sig-contact-item">📍 {{data.adresse}}</span>{{/if}}
      {{#if data.note}}<span class="sig-rating">★ {{data.note}}</span>{{/if}}
    </div>
    <div class="sig-row">
      {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item">📞 {{data.telephone}}</a>{{/if}}
      {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item">🌐 Réservation</a>{{/if}}
      {{#if data.instagram}}<a href="{{data.instagram}}" class="sig-contact-item">📸 Instagram</a>{{/if}}
    </div>
    {{#if data.site}}
    <a href="{{data.site}}" class="sig-cta">Réserver maintenant ✨</a>
    {{/if}}
  </div>
</div>
</body>
</html>
