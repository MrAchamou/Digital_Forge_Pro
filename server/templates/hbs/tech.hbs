<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root { --sig-bg:{{palette.background}}; --sig-accent:{{palette.accent}}; --sig-text:{{palette.text}}; --sig-muted:{{palette.muted}}; --sig-border:{{palette.border}}; }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:transparent; font-family:'Segoe UI',Arial,sans-serif; }
  @keyframes sigLogoGlow { 0%,100% { box-shadow:0 0 0 2px var(--sig-accent),0 0 14px var(--sig-accent)50,0 0 28px var(--sig-accent)20; } 50% { box-shadow:0 0 0 3px var(--sig-accent),0 0 28px var(--sig-accent)80,0 0 60px var(--sig-accent)40; } }
  @keyframes sigLogoIn { 0% { opacity:0; transform:scale(0.6); filter:blur(8px) brightness(3); } 60% { transform:scale(1.06); filter:blur(0) brightness(1.3); } 100% { opacity:1; transform:scale(1); filter:blur(0) brightness(1); } }
  @keyframes sigNeonPulse { 0%,100% { text-shadow:0 0 6px var(--sig-accent),0 0 14px var(--sig-accent)60; } 50% { text-shadow:0 0 18px var(--sig-accent),0 0 36px var(--sig-accent)80,0 0 70px var(--sig-accent)40; } }
  @keyframes sigBarSlide { 0% { transform:scaleX(0); } 100% { transform:scaleX(1); } }
  @keyframes sigFade { 0% { opacity:0; } 100% { opacity:1; } }
  @keyframes sigSlideUp { 0% { opacity:0; transform:translateY(12px); } 100% { opacity:1; transform:translateY(0); } }
  @keyframes sigGlitch { 0%,90%,100% { transform:translate(0); clip-path:none; } 92% { transform:translate(-2px,1px); clip-path:inset(10% 0 80% 0); color:#0ff; } 94% { transform:translate(2px,-1px); clip-path:inset(60% 0 20% 0); color:#f0f; } 96% { transform:translate(0); clip-path:none; } }
  @keyframes sigTypewriter { 0% { opacity:0; clip-path:inset(0 100% 0 0); } 100% { opacity:1; clip-path:inset(0 0% 0 0); } }

  .sig-wrap { display:inline-flex; flex-direction:column; background:var(--sig-bg); border:1px solid var(--sig-border); border-radius:10px; width:{{layout.width}}px; overflow:hidden; position:relative; }
  .sig-top-bar { height:3px; background:linear-gradient(90deg, transparent, var(--sig-accent), #22d3ee, #a78bfa, var(--sig-accent), transparent); transform-origin:left; animation:sigBarSlide 0.8s ease-out both; }
  .sig-main { display:flex; align-items:stretch; padding:16px 18px; gap:16px; }
  .sig-logo-zone { flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:8px; }
  .sig-logo-frame { width:72px; height:72px; border-radius:10px; overflow:hidden; background:linear-gradient(135deg,var(--sig-accent)20,#06b6d408); display:flex; align-items:center; justify-content:center; animation:sigLogoIn 1s ease-out 0s both,sigLogoGlow 2.5s ease-in-out 1.5s infinite; }
  .sig-logo-frame img { width:100%; height:100%; object-fit:contain; padding:6px; }
  .sig-logo-emoji { font-size:34px; line-height:1; }
  .sig-logo-dot { width:8px; height:8px; border-radius:50%; background:var(--sig-accent); animation:sigNeonPulse 1.5s ease-in-out 2s infinite; }
  .sig-vdivider { width:1px; background:linear-gradient(180deg,transparent,var(--sig-accent)70,transparent); flex-shrink:0; margin:4px 0; }
  .sig-info { flex:1; display:flex; flex-direction:column; gap:8px; min-width:0; }
  .sig-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
  .sig-header-left { display:flex; flex-direction:column; gap:2px; }
  .sig-name { font-size:18px; font-weight:800; color:var(--sig-text); line-height:1.1; opacity:0; animation:sigTypewriter 1.2s ease-out 0.3s both,sigGlitch 8s ease-in-out 3s infinite; }
  .sig-titre { font-size:11px; font-weight:700; color:var(--sig-accent); text-transform:uppercase; letter-spacing:0.12em; opacity:0; animation:sigSlideUp 0.8s ease-out 0.6s both; }
  .sig-rating { display:flex; align-items:center; gap:4px; font-size:11px; color:var(--sig-muted); opacity:0; animation:sigFade 0.8s ease-out 1.2s both; white-space:nowrap; flex-shrink:0; }
  .sig-stars { color:#fbbf24; font-size:11px; }
  .sig-hdivider { height:1px; background:linear-gradient(90deg,var(--sig-accent)60,transparent); opacity:0; animation:sigFade 0.8s ease-out 0.8s both; }
  .sig-contacts { display:grid; grid-template-columns:1fr 1fr; gap:5px 14px; }
  .sig-contact-item { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--sig-text); text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; opacity:0; }
  .sig-contact-item.phone { font-size:14px; font-weight:800; color:var(--sig-accent); animation:sigSlideUp 0.7s ease-out 0.9s both,sigNeonPulse 2s ease-in-out 2s infinite; }
  .sig-contact-item.email { animation:sigSlideUp 0.8s ease-out 1.1s both; }
  .sig-contact-item.site { animation:sigSlideUp 0.8s ease-out 1.2s both; }
  .sig-contact-item.portfolio { animation:sigFade 0.8s ease-out 1.4s both; }
  .sig-icon { width:14px; height:14px; flex-shrink:0; font-size:12px; display:inline-flex; align-items:center; justify-content:center; color:var(--sig-accent); }
  .sig-badges { display:flex; flex-wrap:wrap; gap:5px; margin-top:2px; }
  .sig-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:4px; font-size:10px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; opacity:0; font-family:monospace; }
  .sig-badge.filled { background:var(--sig-accent); color:var(--sig-bg); animation:sigFade 0.8s ease-out 1.6s both; }
  .sig-badge.outline { background:transparent; border:1px solid var(--sig-accent); color:var(--sig-accent); animation:sigFade 0.8s ease-out 1.8s both; }
  .sig-cta-bar { display:flex; align-items:center; justify-content:space-between; padding:9px 18px; background:linear-gradient(90deg,var(--sig-accent)18,transparent); border-top:1px solid var(--sig-accent)30; opacity:0; animation:sigFade 1s ease-out 2s both; }
  .sig-cta-text { font-size:11px; font-weight:600; color:var(--sig-accent); letter-spacing:0.04em; font-family:monospace; }
  .sig-cta-arrow { font-size:14px; color:var(--sig-accent); animation:sigNeonPulse 1.5s ease-in-out 3s infinite; }
  a { text-decoration:none; color:inherit; } a:hover { color:var(--sig-accent); }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-top-bar"></div>
  <div class="sig-main">
    <div class="sig-logo-zone">
      <div class="sig-logo-frame">
        {{#if data.logo_url}}<img src="{{data.logo_url}}" alt="{{data.entreprise}}">
        {{else}}<span class="sig-logo-emoji">💻</span>{{/if}}
      </div>
      <div class="sig-logo-dot"></div>
    </div>
    <div class="sig-vdivider"></div>
    <div class="sig-info">
      <div class="sig-header">
        <div class="sig-header-left">
          <span class="sig-name">{{data.nom}}</span>
          <span class="sig-titre">{{data.titre}}</span>
        </div>
        {{#if data.note}}<div class="sig-rating"><span class="sig-stars">★</span> {{data.note}}</div>{{/if}}
      </div>
      <div class="sig-hdivider"></div>
      <div class="sig-contacts">
        {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item phone"><span class="sig-icon">📞</span> {{data.telephone}}</a>{{/if}}
        {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item email"><span class="sig-icon">✉</span> {{data.email}}</a>{{/if}}
        {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item site" target="_blank"><span class="sig-icon">🌐</span> {{data.site}}</a>{{/if}}
        {{#if data.portfolio}}<a href="{{data.portfolio}}" class="sig-contact-item portfolio" target="_blank"><span class="sig-icon">📁</span> {{data.portfolio}}</a>{{/if}}
      </div>
      <div class="sig-badges">
        {{#if data.technologies}}<span class="sig-badge filled">&lt;/&gt; {{data.technologies}}</span>{{/if}}
        {{#if data.disponibilite}}<span class="sig-badge outline">✓ {{data.disponibilite}}</span>{{/if}}
      </div>
    </div>
  </div>
  <div class="sig-cta-bar">
    <span class="sig-cta-text">// {{cta}}</span>
    <span class="sig-cta-arrow">→</span>
  </div>
</div>
</body>
</html>
