<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  {{{animation.keyframes}}}
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }
  .sig-wrap {
    display: inline-flex;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 8px;
    width: {{layout.width}}px;
    min-height: {{layout.height}}px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.12);
  }
  .sig-photo-col {
    width: 90px;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--sig-accent)22, var(--sig-muted)33);
  }
  .sig-photo-col img { width: 100%; height: 100%; object-fit: cover; }
  .sig-photo-placeholder { font-size: 40px; }
  .sig-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .sig-header {
    padding: 14px 20px 12px;
    border-bottom: 1px solid var(--sig-border);
  }
  .sig-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--sig-text);
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-weight: 600;
    border-right: 2px solid var(--sig-accent);
    padding-right: 4px;
    animation: {{animation.cssAnimation}};
    display: inline-block;
    margin-top: 2px;
  }
  .sig-etablissement {
    font-size: 12px;
    color: var(--sig-muted);
    margin-top: 2px;
  }
  .sig-content {
    padding: 12px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sig-badges { display: flex; flex-wrap: wrap; gap: 5px; }
  .sig-badge {
    font-size: 11px;
    padding: 2px 10px;
    background: var(--sig-accent);
    color: #fff;
    border-radius: 20px;
  }
  .sig-badge.outline {
    background: transparent;
    border: 1px solid var(--sig-accent);
    color: var(--sig-accent);
  }
  .sig-contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
  }
  .sig-contact-item {
    font-size: 12px;
    color: var(--sig-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sig-contact-item:hover { color: var(--sig-accent); }
  .sig-cta {
    display: inline-block;
    background: var(--sig-accent);
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 4px;
    align-self: flex-start;
    margin-top: 4px;
  }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-photo-col">
    {{#if data.photo_url}}
    <img src="{{data.photo_url}}" alt="{{data.nom}}">
    {{else}}
    <div class="sig-photo-placeholder">🎓</div>
    {{/if}}
  </div>
  <div class="sig-body">
    <div class="sig-header">
      <div class="sig-name">{{data.nom}}</div>
      <div class="sig-titre">{{data.titre}}</div>
      {{#if data.etablissement}}<div class="sig-etablissement">{{data.etablissement}}</div>{{/if}}
    </div>
    <div class="sig-content">
      <div class="sig-badges">
        {{#if data.niveaux}}<span class="sig-badge">{{data.niveaux}}</span>{{/if}}
        {{#if data.certifications}}<span class="sig-badge outline">✓ {{data.certifications}}</span>{{/if}}
      </div>
      <div class="sig-contacts">
        {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item">📞 {{data.telephone}}</a>{{/if}}
        {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item">✉ {{data.email}}</a>{{/if}}
        {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item">🌐 Plateforme</a>{{/if}}
      </div>
      {{#if data.telephone}}
      <a href="tel:{{data.telephone}}" class="sig-cta">Prendre un cours →</a>
      {{/if}}
    </div>
  </div>
</div>
</body>
</html>
