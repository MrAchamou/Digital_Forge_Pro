<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --sig-bg: {{palette.background}};
    --sig-accent: {{palette.accent}};
    --sig-text: {{palette.text}};
    --sig-muted: {{palette.muted}};
    --sig-border: {{palette.border}};
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: transparent; font-family: 'Segoe UI', Arial, sans-serif; }

  /* === KEYFRAMES NARRATIFS — ÉDUCATION === */
  @keyframes sigBreathing {
    0%,100% { transform:scale(1); }
    50% { transform:scale(1.025); }
  }
  @keyframes sigSoulAura {
    0%,100% { filter:drop-shadow(0 0 0 transparent); }
    50% { filter:drop-shadow(0 0 8px rgba(59,130,246,0.4)); }
  }
  @keyframes sigTypewriter {
    from { clip-path:inset(0 100% 0 0); }
    to { clip-path:inset(0 0% 0 0); }
  }
  @keyframes sigParticleBuild {
    0% { opacity:0; letter-spacing:0.35em; filter:blur(3px); }
    100% { opacity:1; letter-spacing:normal; filter:blur(0); }
  }
  @keyframes sigDnaBuild {
    0% { opacity:0; transform:perspective(400px) rotateX(55deg); }
    100% { opacity:1; transform:perspective(400px) rotateX(0deg); }
  }
  @keyframes sigHeartbeat {
    0%,100% { transform:scale(1); }
    14% { transform:scale(1.1); }
    28% { transform:scale(1); }
    42% { transform:scale(1.06); }
  }
  @keyframes sigCrystalGrow {
    0% { opacity:0; transform:scale(0.8) rotate(-2deg); filter:brightness(1.8); }
    100% { opacity:1; transform:scale(1) rotate(0deg); filter:brightness(1); }
  }
  @keyframes sigFadeLayers {
    0% { opacity:0; }
    100% { opacity:1; }
  }
  @keyframes sigTypingCursor {
    0%,100% { border-right-color:var(--sig-accent); }
    50% { border-right-color:transparent; }
  }

  /* === ELEMENTS NARRATIFS === */
  .sig-el-nom {
    animation: sigBreathing 2.5s ease-in-out 0s infinite, sigSoulAura 2.5s ease-in-out 0s infinite;
  }
  .sig-el-titre {
    opacity: 0;
    overflow: hidden;
    animation: sigTypewriter 1.5s steps(30,end) 0.8s both;
    border-right: 2px solid var(--sig-accent);
    animation: sigTypewriter 1.5s steps(30,end) 0.8s both, sigTypingCursor 1s step-end 0.8s infinite;
  }
  .sig-el-niveaux {
    opacity: 0;
    animation: sigDnaBuild 1.2s ease-out 1.5s both;
  }
  .sig-el-telephone {
    opacity: 0;
    animation: sigFadeLayers 0.6s ease-out 2.2s both, sigHeartbeat 2s ease-in-out 3s infinite;
  }
  .sig-el-certifications {
    opacity: 0;
    animation: sigCrystalGrow 1s ease-out 3s both;
  }
  .sig-el-email {
    opacity: 0;
    animation: sigFadeLayers 0.8s ease-out 3.5s both;
  }

  .sig-wrap {
    display: inline-flex;
    background: var(--sig-bg);
    border: 1px solid var(--sig-border);
    border-radius: 8px;
    width: {{layout.width}}px;
    min-height: {{layout.height}}px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(59,130,246,0.12);
  }
  .sig-photo-col {
    width: 90px;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(59,130,246,0.13), rgba(147,197,253,0.2));
  }
  .sig-photo-col img { width: 100%; height: 100%; object-fit: cover; }
  .sig-photo-placeholder { font-size: 40px; }
  .sig-body { flex: 1; display: flex; flex-direction: column; }
  .sig-header {
    padding: 14px 20px 12px;
    border-bottom: 1px solid var(--sig-border);
  }
  .sig-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--sig-text);
    display: inline-block;
  }
  .sig-titre {
    font-size: 13px;
    color: var(--sig-accent);
    font-weight: 600;
    padding-right: 4px;
    display: inline-block;
    margin-top: 2px;
    overflow: hidden;
  }
  .sig-etablissement { font-size: 12px; color: var(--sig-muted); margin-top: 2px; }
  .sig-content {
    padding: 12px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sig-badges { display: flex; flex-wrap: wrap; gap: 5px; }
  .sig-badge {
    font-size: 11px;
    padding: 2px 10px;
    background: var(--sig-accent);
    color: #fff;
    border-radius: 20px;
  }
  .sig-badge.outline {
    background: transparent;
    border: 1px solid var(--sig-accent);
    color: var(--sig-accent);
  }
  .sig-contacts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
  }
  .sig-contact-item {
    font-size: 12px;
    color: var(--sig-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .sig-contact-item:hover { color: var(--sig-accent); }
  .sig-cta {
    display: inline-block;
    background: var(--sig-accent);
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 4px;
    align-self: flex-start;
    margin-top: 4px;
  }
</style>
</head>
<body>
<div class="sig-wrap">
  <div class="sig-photo-col">
    {{#if data.photo_url}}
    <img src="{{data.photo_url}}" alt="{{data.nom}}">
    {{else}}
    <div class="sig-photo-placeholder">🎓</div>
    {{/if}}
  </div>
  <div class="sig-body">
    <div class="sig-header">
      <div class="sig-name sig-el-nom">{{data.nom}}</div>
      <div class="sig-titre sig-el-titre">{{data.titre}}</div>
      {{#if data.etablissement}}<div class="sig-etablissement">{{data.etablissement}}</div>{{/if}}
    </div>
    <div class="sig-content">
      <div class="sig-badges sig-el-niveaux">
        {{#if data.niveaux}}<span class="sig-badge">{{data.niveaux}}</span>{{/if}}
        {{#if data.certifications}}<span class="sig-badge outline sig-el-certifications">✓ {{data.certifications}}</span>{{/if}}
      </div>
      <div class="sig-contacts">
        {{#if data.telephone}}<a href="tel:{{data.telephone}}" class="sig-contact-item sig-el-telephone">📞 {{data.telephone}}</a>{{/if}}
        {{#if data.email}}<a href="mailto:{{data.email}}" class="sig-contact-item sig-el-email">✉ {{data.email}}</a>{{/if}}
        {{#if data.site}}<a href="{{data.site}}" class="sig-contact-item sig-el-email">🌐 Plateforme</a>{{/if}}
      </div>
      {{#if data.telephone}}
      <a href="tel:{{data.telephone}}" class="sig-cta sig-el-telephone">Prendre un cours →</a>
      {{/if}}
    </div>
  </div>
</div>
</body>
</html>
